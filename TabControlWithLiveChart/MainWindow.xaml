<Window x:Class="TabControlWithLiveChart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TabControlWithLiveChart"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525">
    <Window.Resources>
        <!-- Edge shadows that appear on a chart's plot area while there is
             still data scrollable in that direction. Black at the edge,
             fading to transparent over 30 px. -->
        <LinearGradientBrush x:Key="LeftShadowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#55000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RightShadowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#55000000" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="Chart">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Click="InjectStopOnClick">
                        Inject/Stop Data
                    </Button>
                    <Grid Grid.Row="1">
                        <!--Here we disable tooltips and hovering to get a better performance-->
                        <lvc:CartesianChart x:Name="Chart" AnimationsSpeed="0:0:0.15" DisableAnimations="True" Pan="X" IsVisibleChanged="OnChartIsVisibleChanged" Hoverable="False" DataTooltip="{x:Null}">
                            <lvc:CartesianChart.Series>
                                <lvc:LineSeries Values="{Binding ChartValues}"
                                                PointGeometry="{x:Null}"
                                                LineSmoothness="1"
                                                StrokeThickness="4"
                                                Stroke="#F34336"
                                                Fill="Transparent"/>

                                <lvc:LineSeries Values="{Binding ChartValues2}"
                                                PointGeometry="{x:Null}"
                                                LineSmoothness="1"
                                                StrokeThickness="3"
                                                Stroke="DarkGoldenrod"
                                                Fill="Transparent"/>
                            </lvc:CartesianChart.Series>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis LabelFormatter="{Binding DateTimeFormatter}"
                                          Unit="{Binding AxisUnit}" Title="Time">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="{Binding AxisStep}" />
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="PWM"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>

                        <!-- Overlay for the "more data this way" edge
                             shadows. IsHitTestVisible=False so the
                             shadows never intercept pan/click. -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="ChartLeftShadow" Width="30"
                                       Fill="{StaticResource LeftShadowBrush}"
                                       Visibility="Collapsed"/>
                            <Rectangle x:Name="ChartRightShadow" Width="30"
                                       Fill="{StaticResource RightShadowBrush}"
                                       Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Test">
                <Grid>
                    <lvc:CartesianChart x:Name="Chart2" AnimationsSpeed="0:0:0.15" DisableAnimations="True" Pan="X" IsVisibleChanged="OnChartIsVisibleChanged" Hoverable="False" DataTooltip="{x:Null}">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Values="{Binding ChartValues}"
                                            PointGeometry="{x:Null}"
                                            LineSmoothness="1"
                                            StrokeThickness="4"
                                            Stroke="#F34336"
                                            Fill="Transparent"/>
                            <lvc:LineSeries Values="{Binding ChartValues2}"
                                            PointGeometry="{x:Null}"
                                            LineSmoothness="1"
                                            StrokeThickness="3"
                                            Stroke="DarkGoldenrod"
                                            Fill="Transparent"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis LabelFormatter="{Binding DateTimeFormatter}"
                                      Unit="{Binding AxisUnit}" Title="Time">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="{Binding AxisStep}" />
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="PWM"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>

                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="Chart2LeftShadow" Width="30"
                                   Fill="{StaticResource LeftShadowBrush}"
                                   Visibility="Collapsed"/>
                        <Rectangle x:Name="Chart2RightShadow" Width="30"
                                   Fill="{StaticResource RightShadowBrush}"
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
